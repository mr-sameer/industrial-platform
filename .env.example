# ==============================================================================
# ForgeX — Environment Variables (example)
# Copy this file to `.env` at the repo root for docker-compose, and to
# apps/web/.env.local / apps/api/.env for app-specific local runs.
# NEVER commit a real .env file. Module 1 ships no auth secrets — placeholders
# below exist only to keep the shape stable for Module 2.
# ==============================================================================

# ---- General ----
NODE_ENV=development
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=info                     # debug | info | warn | error

# ---- Web (Next.js) ----
NEXT_PUBLIC_APP_NAME="ForgeX"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000

# ---- API (FastAPI) ----
API_PORT=8000
API_HOST=0.0.0.0
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=industrial_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://platform_user:change_me_locally@postgres:5432/industrial_platform
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://platform_user:change_me_locally@postgres:5432/industrial_platform

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---- Auth (Module 2) ----
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Web BFF cookie (Module 2) ----
# Name of the httpOnly cookie the Next.js route handlers use to store the
# refresh token on the web app's own domain. See docs/adr/0012.
REFRESH_TOKEN_COOKIE_NAME=refresh_token
