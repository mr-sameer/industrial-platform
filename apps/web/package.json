{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3000}",
    "dev:pretty": "next dev -p ${WEB_PORT:-3000} | pino-pretty",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3000}",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next dist coverage"
  },
  "dependencies": {
    "@platform/shared-types": "workspace:*",
    "@platform/ui": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.0.19",
    "@fontsource/inter": "^5.0.20",
    "@fontsource/space-grotesk": "^5.0.20",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.427.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pino": "^9.3.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/tsconfig": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "1.56.0",
    "@types/pg": "^8.11.6",
    "pg": "^8.12.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
