ENVIRONMENT=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# This is the LOCAL (bare `uvicorn`, native/Homebrew Postgres) value —
# it is NOT the canonical Docker database. docker-compose.yml's `api`
# service always overrides DATABASE_URL/DATABASE_URL_SYNC to
# `postgres:5432` (the Compose network hostname) regardless of this
# file; a script run bare on the host with no override lands here
# instead, silently, even if a Docker Postgres is also running — see
# app.core.config.Settings' own comment on database_url for the real
# incident this caused. To reach the canonical Docker database from
# outside a container, use `docker exec platform-postgres psql ...` or
# `docker compose exec api ...`.
DATABASE_URL=postgresql+asyncpg://platform_user:change_me_locally@localhost:5432/industrial_platform
DATABASE_URL_SYNC=postgresql+psycopg://platform_user:change_me_locally@localhost:5432/industrial_platform
REDIS_URL=redis://localhost:6379/0

# ---- Auth (Module 2) ----
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File storage (Module 3B) ----
# LocalStorageBackend today — see app.core.storage. A future S3Backend
# would replace these two with a bucket name / endpoint, not add new
# settings elsewhere.
#
# This is the LOCAL (bare `uvicorn`) value — matches DATABASE_URL's
# pattern above: this file holds what works for a plain local run, and
# docker-compose.yml's `environment:` block for the api service
# explicitly overrides it to /app/uploads for the container, the same
# way it overrides DATABASE_URL. If you're editing this by hand, leave
# it commented out to fall back to app.core.config's own local-safe
# default (apps/api/uploads/, resolved relative to the app package, not
# your shell's current directory) — see docs/adr/0030.
# UPLOAD_STORAGE_PATH=./uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8000/uploads
UPLOAD_MAX_LOGO_SIZE_BYTES=5242880
UPLOAD_MAX_COVER_SIZE_BYTES=10485760
UPLOAD_MAX_DOCUMENT_SIZE_BYTES=15728640

# ---- USA industrial data sources (Module 6D) ----
# Both optional — only required to run the real SEC/Census/USITC
# acquisition pilot; every other endpoint works with these unset.
# Census: register a free key at https://api.census.gov/data/key_signup.html
# USITC DataWeb: generate a token from the "API" tab after signing in at
# https://dataweb.usitc.gov/sign-in — tokens expire every 6 months and
# do not auto-renew. SEC EDGAR's public API needs no key.
CENSUS_API_KEY=
USITC_DATAWEB_API_TOKEN=
