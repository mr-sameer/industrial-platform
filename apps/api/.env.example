ENVIRONMENT=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://platform_user:change_me_locally@localhost:5432/industrial_platform
DATABASE_URL_SYNC=postgresql+psycopg://platform_user:change_me_locally@localhost:5432/industrial_platform
REDIS_URL=redis://localhost:6379/0

# ---- Auth (Module 2) ----
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
